{
  "tests": [
    {
      "name": "Validation - missing fields",
      "method": "POST",
      "path": "/",
      "body": {"name": "", "email": "", "phone": "", "message": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "Заполните обязательные поля: Имя, Email, Телефон, Сообщение"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Validation - invalid email",
      "method": "POST",
      "path": "/",
      "body": {"name": "Тест", "email": "not-email", "phone": "+79990000000", "message": "Проверка"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Некорректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Заявка сохраняется даже при сбое почты",
      "method": "POST",
      "path": "/",
      "body": {"name": "Автотест", "email": "autotest@mat-labs.ru", "phone": "+79990000001", "company": "Автотест", "message": "Проверка сохранения заявки"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Под ключ - короткий телефон",
      "method": "POST",
      "path": "/",
      "body": {"source": "turnkey", "name": "Тест", "phone": "123", "product": "АВАНГАРД"},
      "expectedStatus": 400,
      "expectedBody": {"field": "phone"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Под ключ - без проекта",
      "method": "POST",
      "path": "/",
      "body": {"source": "turnkey", "name": "Тест", "phone": "+7 999 000-00-02"},
      "expectedStatus": 400,
      "expectedBody": {"field": "product"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Под ключ - бот отсекается",
      "method": "POST",
      "path": "/",
      "body": {"source": "turnkey", "website": "spam.ru", "name": "Бот", "phone": "+79990000003", "product": "АВАНГАРД"},
      "expectedStatus": 200,
      "expectedBody": {"success": true, "notified": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Под ключ - успешная заявка без email",
      "method": "POST",
      "path": "/",
      "body": {"source": "turnkey", "name": "Автотест", "phone": "+7 999 000-00-04", "product": "Автотест", "plan": "Старт", "city": "Самара", "message": "Проверка"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    }
  ]
}